{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatGPT Desktop Switcher",
  "version": "0.1.0",
  "identifier": "net.odiak.chatgpt-desktop-switcher",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ChatGPT Desktop Switcher",
        "width": 760,
        "height": 620,
        "minWidth": 620,
        "minHeight": 500,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/chatgpt-desktop-switcher.icns"
    ]
  }
}
